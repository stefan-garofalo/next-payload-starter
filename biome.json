{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite"],
  "files": {
    "includes": [
      "!src/modules/ui",
      "!src/payload-types.ts",
      "!src/migrations",
      "!src/app/(payload)/*"
    ]
  },
  "javascript": {
    "globals": ["Bun"],
    "formatter": {
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "nursery": {
        "useSortedClasses": "warn"
      },
      "correctness": {
        "noChildrenProp": "off"
      },
      "a11y": {
        "useButtonType": "off"
      },
      "style": {
        "noNestedTernary": "off",
        "useBlockStatements": "off",
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "noBannedTypes": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noUnknownAtRules": "off"
      }
    }
  }
}
