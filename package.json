    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.36.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.5.5",
    "lefthook": "2.1.14",
    "postcss": "^8.5.6",
