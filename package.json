{
  "name": "next-payload-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --experimental-https",
    "start": "next start",
    "lint": "eslint .",
    "next:typegen": "next typegen",
    "build": "sh scripts/migrate-unless-preview.sh && next build",
    "build:prod": "payload migrate && next build",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "payload:migration:create": "payload migrate:create",
    "payload:typegen": "PAYLOAD_CONFIG_PATH=./src/payload.config.ts payload generate:types",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "infra:deploy": "alchemy deploy --stage prod",
    "infra:plan": "alchemy plan --stage prod",
    "prepare": "node .agents/scripts/activate-git-hooks.mjs"
  },
  "overrides": {
    "libsql": "v0.6.0-pre.20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/live-preview-react": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/plugin-seo": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/storage-s3": "3.92.0",
    "@payloadcms/translations": "3.92.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.90.21",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "@xstate/react": "^6.1.0",
    "arktype": "^2.1.22",
