    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "0.5.2",
    "effect": "^4",
    "eslint-config-next": "16.4.3",
    "graphql": "^16.11.0",
    "lucide-react": "^0.525.0",
    "next": "16.4.3",
    "nuqs": "^2.8.8",
    "payload": "3.92.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.34.5",
